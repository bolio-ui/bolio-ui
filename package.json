{
  "name": "@bolio-ui/core",
  "version": "2.0.0-alpha.1",
  "description": "Amazing, modern and creative tools for React UI. 🥷🏼",
  "keywords": [
    "bolio",
    "bolio ui",
    "components",
    "modern components",
    "react components",
    "react ui"
  ],
  "homepage": "https://bolio-ui.com/",
  "bugs": {
    "url": "https://github.com/bolio-ui/bolio-ui/issues/new/choose"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bolio-ui/bolio-ui"
  },
  "license": "MIT",
  "author": {
    "name": "Bruno Andrade",
    "email": "brunnoandradi@gmail.com"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "unpkg": "dist/index.min.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "module": "./esm/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./esm/Next/index.d.ts",
      "module": "./esm/Next/index.js",
      "default": "./dist/Next/index.js"
    },
    "./dist/index.js": "./dist/index.js",
    "./dist/*/index.js": "./dist/*/index.js",
    "./dist/*": "./dist/*/index.js",
    "./esm/index.js": "./esm/index.js",
    "./esm/*/index.js": "./esm/*/index.js",
    "./esm/*": "./esm/*/index.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "next": [
        "esm/Next/index.d.ts"
      ]
    }
  },
  "files": [
    "/dist",
    "/esm"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "yarn test --watch",
    "generate": "yarn plop --plopfile generators/plopfile.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:storybook": "storybook build",
    "build:clear": "rm -rf ./dist ./esm",
    "build:js": "tsup --config scripts/tsup.config.ts",
    "build:after": "node scripts/add-use-client.js",
    "build:webpack": "webpack --config scripts/webpack.config.js",
    "build:types": "tsc -p ./scripts && tsc -p ./scripts --outDir ./esm",
    "build:package": "yarn build:clear && yarn build:js && yarn build:types && yarn build:after",
    "clear-all": "rm -rf .next _static node_modules",
    "re-start": "rm -rf .next _static node_modules && yarn install && yarn dev",
    "re-build": "rm -rf .next _static node_modules && yarn install && yarn build",
    "release": "yarn build && yarn build:package && yarn publish --access public --non-interactive",
    "release:next": "yarn build:package && yarn publish --access public --tag next --non-interactive"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "yarn lint --fix",
      "yarn test --findRelatedTests --bail"
    ]
  },
  "dependencies": {
    "styled-jsx": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-syntax-typescript": "^7",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@bolio-ui/icons": "^1.0.4",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16",
    "@serwist/next": "^9",
    "@storybook/addon-docs": "^10.6",
    "@storybook/react-vite": "^10.6",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/jest": "^30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.4",
    "@types/styled-components": "^5.1.11",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^5",
    "axe-core": "^4.3.2",
    "babel-loader": "^8.2.2",
    "babel-plugin-styled-components": "^1.13.2",
    "classnames": "^2.3.1",
    "eslint": "^8.57",
    "eslint-config-next": "11.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.37",
    "eslint-plugin-react-hooks": "^4.6",
    "eslint-plugin-storybook": "^0.6.4",
    "gray-matter": "^4.0.3",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "jest-styled-components": "^7.0.5",
    "kbar": "0.1.0-beta.6",
    "lint-staged": "^11.1.1",
    "next": "^16",
    "plop": "^2.7.4",
    "prettier": "2.3.2",
    "prism-react-renderer": "^1.2.1",
    "react": "^19",
    "react-device-detect": "^1.17.0",
    "react-dom": "^19",
    "react-live": "^2.2.3",
    "react-syntax-highlighter": "^15.5.0",
    "rehype-join-line": "^1.0.2",
    "remark-autolink-headings": "^6.0.1",
    "remark-gfm": "^4.0.1",
    "remark-slug": "^6.0.0",
    "serwist": "^9",
    "storybook": "^10.6",
    "styled-components": "^5.3.0",
    "tsup": "^8",
    "typescript": "~5.9.3",
    "vite": "^8"
  },
  "resolutions": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
