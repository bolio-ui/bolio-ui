import React from 'react'
import { render, screen } from '@testing-library/react'
import { BolioUIProvider } from '../..'
import {{pascalCase name}} from '..'

describe('<{{pascalCase name}} />', () => {
  it('should render its children', () => {
    render(
      <BolioUIProvider>
        <{{pascalCase name}}>{{pascalCase name}}</{{pascalCase name}}>
      </BolioUIProvider>
    )

    expect(screen.getByText('{{pascalCase name}}')).toBeInTheDocument()
  })

  it('should forward className', () => {
    render(
      <BolioUIProvider>
        <{{pascalCase name}} className="custom">{{pascalCase name}}</{{pascalCase name}}>
      </BolioUIProvider>
    )

    expect(screen.getByText('{{pascalCase name}}')).toHaveClass('custom')
  })
})
