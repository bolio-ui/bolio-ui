{
  "compilerOptions": {
    "baseUrl": "../",
    "outDir": "../dist",
    "paths": {
      "*": ["*"],
      "bolio-ui": ["core/index.tsx"],
      "core/*": ["core/*"]
    },
    "declaration": true,
    "types": [],
    "emitDeclarationOnly": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "preserve",
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "target": "es6",
    "lib": ["dom", "es2019"],
    "skipLibCheck": true,
    "allowJs": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "files": ["../core/index.ts", "../core/Next/index.ts"],
  "exclude": ["node_modules", "lib", "es"]
}
